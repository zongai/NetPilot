<?xml version="1.0" encoding="utf-8"?>
<!-- NP-143: Subscription management UI shell (WinUI 3). Data via IPC; no network in UI. -->
<Page
    x:Class="NetPilot.Desktop.SubscriptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid Padding="24" RowDefinitions="Auto,Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <TextBlock Text="Subscriptions" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
      <Button x:Name="AddButton" Content="Add" Click="AddButton_Click"/>
      <Button x:Name="RefreshAllButton" Content="Update all" Click="RefreshAllButton_Click"/>
    </StackPanel>
    <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" Margin="0,0,0,12"/>
    <ListView x:Name="SubscriptionList" Grid.Row="2" SelectionMode="Single">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto,Auto" Padding="8">
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding UrlDisplay}" Opacity="0.7" TextWrapping="NoWrap"/>
              <TextBlock Text="{Binding TrafficSummary}" FontSize="12" Opacity="0.8"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" Margin="12,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button Content="Update" Command="{Binding UpdateCommand}"/>
              <ToggleSwitch IsOn="{Binding Enabled, Mode=TwoWay}"/>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
