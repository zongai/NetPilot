<Window
    x:Class="NetPilot.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NetPilot">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <NavigationView
            x:Name="NavView"
            Grid.Column="0"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" Icon="Home" />
                <NavigationViewItem Content="Proxies" Tag="proxies" Icon="Switch" />
                <NavigationViewItem Content="Rules" Tag="rules" Icon="Filter" />
                <NavigationViewItem Content="Connections" Tag="connections" Icon="Shuffle" />
                <NavigationViewItem Content="Logs" Tag="logs" Icon="Document" />
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics" Icon="Repair" />
            </NavigationView.MenuItems>
        </NavigationView>

        <Frame
            x:Name="ContentFrame"
            Grid.Column="1"
            Margin="16" />
    </Grid>
</Window>
