<Window x:Class="NetPilot.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPilot" Height="640" Width="960"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Ready"/>
      </StatusBarItem>
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ListBox x:Name="NavList" Grid.Column="0" Margin="8"
               SelectionChanged="NavList_SelectionChanged">
        <ListBoxItem Content="Home" Tag="home" IsSelected="True"/>
        <ListBoxItem Content="Proxies" Tag="proxies"/>
        <ListBoxItem Content="Rules" Tag="rules"/>
        <ListBoxItem Content="Connections" Tag="connections"/>
        <ListBoxItem Content="Logs" Tag="logs"/>
        <ListBoxItem Content="Diagnostics" Tag="diagnostics"/>
        <ListBoxItem Content="Subscriptions" Tag="subscriptions"/>
        <ListBoxItem Content="Settings" Tag="settings"/>
      </ListBox>
      <ScrollViewer Grid.Column="1" Margin="16">
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="16"/>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
